# Personal pressure-test server: publish Docker ports on the server public IP.
BIND_IP=0.0.0.0
SERVER_PUBLIC_IP=CHANGE_ME_SERVER_IP
TZ=Asia/Shanghai

MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=3306
MYSQL_DATABASE=myoj
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

NACOS_IMAGE=nacos/nacos-server:v2.5.1
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_CLIENT_PORT=9849
NACOS_ADMIN_PASSWORD=CHANGE_ME_NACOS_PASSWORD
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m

RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-06-13T11-33-47Z
MINIO_MC_IMAGE=quay.io/minio/mc:latest
MINIO_BIND_IP=0.0.0.0
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=myoj

# Shared HMAC secret between Judge Service and Code Sandbox.
CODESANDBOX_HOST=CHANGE_ME_SERVER_IP
CODESANDBOX_PORT=8090
CODESANDBOX_SECRET_KEY=CHANGE_ME_SANDBOX_HMAC_SECRET
CODESANDBOX_TIMESTAMP_TOLERANCE_SECONDS=300

# Disable only in a dedicated pressure-test environment.
LOAD_TEST_CRAWLER_DETECTION_ENABLED=false

# Recommended baseline for a 2-vCPU Code Sandbox host.
JUDGE_CONSUMER_CONCURRENCY=2
JUDGE_CONSUMER_MAX_CONCURRENCY=2
JUDGE_CONSUMER_PREFETCH=1
JUDGE_OUTBOX_DISPATCH_INTERVAL_MS=500
JUDGE_OUTBOX_BATCH_SIZE=50

# Shared only by Gateway and AI Service. Never expose it to browsers.
GATEWAY_TRUST_TOKEN=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE

# OpenAI-compatible model shared by tutoring and authoring.
AI_CHAT_API_KEY=CHANGE_ME_WITH_YOUR_MODEL_API_KEY
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-v4-flash
AI_CHAT_ENABLED=true
AI_CHAT_RETENTION_DAYS=30
AI_CHAT_AGENT_MAX_STEPS=4
AI_CHAT_STREAM_TIMEOUT=30m
AI_AUTHORING_ENABLED=true
AI_AUTHORING_MAX_REPAIR_COUNT=3
AI_AUTHORING_STALE_AFTER=3m
AI_AUTHORING_RECOVERY_CRON=0 */1 * * * ?
AI_AUTHORING_GRAPH_VERSION=authoring-v1
AI_AUTHORING_PROMPT_VERSION=authoring-v1
AI_AUTHORING_REDIS_DATABASE=1
# Optional: enables the webSearch tool. Leave blank to let the agent continue without web search.
BAIDU_AI_SEARCH_API_KEY=
